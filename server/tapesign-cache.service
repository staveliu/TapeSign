[Unit]
Description=TapeSign permanent contract cache
After=network-online.target
Wants=network-online.target

[Service]
User=tapesign-cache
Group=tapesign-cache
WorkingDirectory=/opt/tapesign-cache
ExecStart=/opt/tapesign-cache/bin/node /opt/tapesign-cache/server/cache.bundle.mjs
Environment=TAPESIGN_CACHE_DIR=/var/lib/tapesign-cache
Environment=HOST=127.0.0.1
Environment=PORT=18741
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tapesign-cache
UMask=0077

[Install]
WantedBy=multi-user.target
